### Server-side environment configuration (Phase 1)

# Host/port for the Adaptive Scheduler Flask API
SCHEDULER_HOST=0.0.0.0
SCHEDULER_PORT=5000

# Host/port for the Yuvidu FastAPI backend
YUVIDU_HOST=0.0.0.0
YUVIDU_PORT=5001

# Base URL for the Cognitive Load Estimator (CLE) as seen from the server
# In Phase 1 the server does not call CLE directly; this is reserved for later
# metrics endpoints or diagnostics.
CLE_API_BASE=http://127.0.0.1:8000

# SQLite database path for the Adaptive Scheduler
ADAPTIVE_SCHEDULER_DB=adaptive_scheduler.db

# Optional: fully-qualified DB URL for SQLAlchemy
# ADAPTIVE_SCHEDULER_DATABASE_URL=sqlite:///adaptive_scheduler.db

# CORS configuration for server APIs
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

