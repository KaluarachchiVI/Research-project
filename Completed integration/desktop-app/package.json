{
  "name": "intentlock-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Electron shell for Intent-Lock + focus lockdown (Completed integration)",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc",
    "start": "npm run build && electron .",
    "dev": "concurrently \"tsc -w\" \"electron .\"",
    "package": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "execa": "^9.5.2",
    "ps-list": "^8.1.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "concurrently": "^9.1.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2"
  },
  "build": {
    "appId": "com.intentlock.desktop",
    "productName": "IntentLock Desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "resources/**/*",
      "scripts/**/*"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
